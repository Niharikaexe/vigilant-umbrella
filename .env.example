# ---------------------------------------------------------------------------
# AgentFlow configuration. Copy to .env and fill in. NEVER commit .env.
# Everything is optional: with no keys set, the service runs in SIMULATED mode
# using deterministic local heuristics, so the demo always works offline.
# ---------------------------------------------------------------------------

# LLM provider: simulated | azure | openai
AGENTFLOW_LLM_PROVIDER=simulated

# --- Azure OpenAI (provider=azure) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# --- OpenAI (provider=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Azure AI Document Intelligence (optional OCR/layout for PDFs) ---
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_API_KEY=

# --- Outbound connectors (all optional; unset = logged, not sent) ---
# Power Automate "When an HTTP request is received" trigger URL
POWER_AUTOMATE_WEBHOOK_URL=
# Microsoft Teams incoming webhook / Workflows URL
TEAMS_WEBHOOK_URL=
# Any downstream business system (ERP, ticketing, CRM)
ERP_API_BASE_URL=
ERP_API_KEY=

# --- Inbound auth: shared secret required on write endpoints when set ---
AGENTFLOW_API_KEY=
